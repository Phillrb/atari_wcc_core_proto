+hole_trace: process
+    file output : text open write_mode is "moving_hole_full_trace.csv";
+    variable row : line;
+    variable v : std_logic_vector(8 downto 0);
+begin
+    write(row, string'("time_10ns,line,hole,attract")); writeline(output,row);
+    loop
+        wait until rising_edge(hsyncn_i);
+        wait for 1 ns;
+        v := v256_i & v128_i & v64_i & v32_i & v16_i & v8_i & v4_i & v2_i & v1_i;
+        write(row, now / 10 ns); write(row, string'(","));
+        write(row, to_integer(unsigned(v))); write(row, string'(","));
+        if hole_i='1' then write(row,1); else write(row,0); end if;
+        write(row, string'(","));
+        if atrc_i='1' then write(row,1); else write(row,0); end if;
+        writeline(output,row);
+    end loop;
+end process;
