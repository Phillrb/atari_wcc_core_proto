set_global_assignment -name VHDL_FILE CatchKickHorizontalDirection.vhd
set_global_assignment -name VHDL_FILE PlayfieldCircuit.vhd
set_global_assignment -name VHDL_FILE PlayersVerticalWindow.vhd
set_global_assignment -name VHDL_FILE atari_wcc_board.vhd
set_global_assignment -name VHDL_FILE PlayersStripedDefenseGoalie.vhd
set_global_assignment -name VHDL_FILE HorizontalDirectionAndSpeed.vhd
set_global_assignment -name VHDL_FILE ElectronicLatchCircuit.vhd
set_global_assignment -name VHDL_FILE SyncSumming.vhd
set_global_assignment -name VHDL_FILE ServeTimingCircuit.vhd
set_global_assignment -name VHDL_FILE 74LS/LS153.vhd
set_global_assignment -name VHDL_FILE 74LS/LS107.vhd
set_global_assignment -name VHDL_FILE 74LS/LS93.vhd
set_global_assignment -name VHDL_FILE 74LS/LS92.vhd
set_global_assignment -name VHDL_FILE 74LS/LS90.vhd
set_global_assignment -name VHDL_FILE 74LS/LS86.vhd
set_global_assignment -name VHDL_FILE 74LS/LS83.vhd
set_global_assignment -name VHDL_FILE 74LS/LS48.vhd
set_global_assignment -name VHDL_FILE 74LS/LS30.vhd
set_global_assignment -name VHDL_FILE 74LS/LS27.vhd
set_global_assignment -name VHDL_FILE 74LS/LS20.vhd
set_global_assignment -name VHDL_FILE 74LS/LS10.vhd
set_global_assignment -name VHDL_FILE 74LS/LS08.vhd
set_global_assignment -name VHDL_FILE 74LS/LS02.vhd
set_global_assignment -name VHDL_FILE 74LS/LS00.vhd
