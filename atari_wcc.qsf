set_global_assignment -name VHDL_FILE IC/IC9316.vhd
set_global_assignment -name VHDL_FILE IC/IC9314.vhd

# EP2C5 board oscillator and composite-video pins: Sprint2v1/sprint2.
set_location_assignment PIN_17 -to Clk_50_I
set_location_assignment PIN_144 -to Reset_I
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to Reset_I
set_location_assignment PIN_92 -to Sync_O
set_location_assignment PIN_86 -to VideoW_O
set_location_assignment PIN_74 -to VideoB_O
set_location_assignment PIN_3 -to LED0
set_location_assignment PIN_80 -to Clock_out
# Mono sound on Sprint2 Audio1_O connector (Audio2_O is unused).
set_location_assignment PIN_71 -to Audio1_O
set_global_assignment -name SDC_FILE atari_wcc.sdc

# JAMMA active-low, normally-open switches (Sprint2 connector assignments).
set_location_assignment PIN_120 -to Coin1_I
set_location_assignment PIN_112 -to Start1_I
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to Coin1_I
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to Start1_I
set_global_assignment -name VHDL_FILE JammaSwitchAdapter.vhd

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top